{
  "name": "fly-track",
  "productName": "Fly Track",
  "private": true,
  "version": "1.0.9",
  "description": "Fly Track — маршрут человека по видео с камеры через мозг мухи",
  "author": "Fly Track",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:ui": "vite build",
    "typecheck": "tsc --noEmit",
    "electron": "electron .",
    "start": "vite build && electron .",
    "build:desktop:win": "vite build && electron-builder --win --x64",
    "build:desktop:mac": "vite build && electron-builder --mac --dir"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.462.0",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^5.4.19"
  },
  "build": {
    "appId": "com.flytrack.app",
    "productName": "Fly Track",
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": ["**/*"]
      }
    ],
    "asar": true,
    "win": {
      "target": ["nsis", "zip"],
      "icon": "assets/fly_track.ico",
      "artifactName": "FlyTrack-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fly Track",
      "differentialPackage": false,
      "artifactName": "FlyTrack-Setup-${version}.${ext}"
    },
    "mac": {
      "target": ["dir"],
      "icon": "assets/fly_track.png"
    }
  }
}
